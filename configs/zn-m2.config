# ============================================================
# ZN-M2 (IPQ6018) 定制固件 config —— LiBwrt 25.12-nss 底座
# 角色：网关+试验田（NOWIFI）；rootfs 24MB 红线，瘦身优先
# ============================================================
# 目标平台
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_zn_m2=y

# ---- LuCI（Web 管理，luci=y 已含核心+常规模块）----
CONFIG_PACKAGE_luci=y

# ---- 网络工具（精简实用组）----
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_tcpdump-mini=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_openssh-sftp-server=y

# ---- 隧道 ----
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_kmod-tun=y

# ---- QoS/SQM（本机型在池子里的存在意义：慢路径整形）----
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_kmod-sched-cake=y

# ---- 断线自愈 + 首刷脚本 + 集客AC（fw-feed 自定义包）----
CONFIG_PACKAGE_watchcat=y
CONFIG_PACKAGE_gecoosac=y
CONFIG_PACKAGE_nc-provision=y

# ---- 多WAN 基础设施（很小，留给 mwan3 可能性但不装）----
CONFIG_PACKAGE_kmod-dummy=y
CONFIG_PACKAGE_kmod-veth=y

# ---- 明确剔除（防默认配置带回撑爆 24MB）----
# WiFi：ZN-M2 无天线版本做有线用；如需 WiFi 用另一条 WIFI profile
# CONFIG_PACKAGE_kmod-ath11k-ahb is not set
# CONFIG_PACKAGE_ath11k-firmware-ipq6018 is not set
# CONFIG_PACKAGE_wpad-openssl is not set
# USB 存储/网卡/音频全盘剔除（本机无可用 USB 口）
# CONFIG_PACKAGE_kmod-usb-storage is not set
# CONFIG_PACKAGE_kmod-usb-net is not set
# CONFIG_PACKAGE_kmod-usb-audio is not set
# CONFIG_PACKAGE_usb-modeswitch is not set
# CONFIG_PACKAGE_blkid is not set
# CONFIG_PACKAGE_gdisk is not set
# CONFIG_PACKAGE_automount is not set
# 体积大户
# CONFIG_PACKAGE_luci-app-homeproxy is not set
# CONFIG_PACKAGE_luci-app-adblock is not set
